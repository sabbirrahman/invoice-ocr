# LLM provider (google | openai | anthropic)
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash

# Google Gemini (default). Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional - only needed if AI_PROVIDER=openai
# OPENAI_API_KEY=

# Optional - only needed if AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Mock accounting system (started by `pnpm dev`)
ACCOUNTING_API_URL=http://localhost:8080
ACCOUNTING_API_KEY=demo-key-1234
